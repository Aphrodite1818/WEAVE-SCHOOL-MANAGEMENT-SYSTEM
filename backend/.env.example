# ====================================== #
#              .env.example              #
# ====================================== #

# --- App ---
ENV=dev
APP_NAME="School Management System"
API_V1_PREFIX=/api/v1
# LOG_LEVEL=INFO

# --- Security ---
# Generate independently for every environment.
# openssl rand -hex 64
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
DEFAULT_SESSION_DAYS=7
REMEMBER_ME_SESSION_DAYS=30

# Dedicated key for temporary encrypted student setup codes.
# Do not reuse SECRET_KEY in staging/production.
# openssl rand -hex 32
BULK_IMPORT_RESULT_ENCRYPTION_KEY=
BULK_IMPORT_SETUP_CODE_RETENTION_HOURS=24
BULK_IMPORT_STALE_AFTER_MINUTES=20

# --- Database ---
DATABASE_URL=
# Configure smaller values for each worker service to avoid exhausting PostgreSQL.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# --- CORS and frontend ---
# Staging/production accept explicit HTTPS origins only. Wildcards are rejected.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
FRONTEND_APP_URL=http://localhost:5173
EMAIL_BRAND_LOGO_URL=
APP_SCRIPT_URL=

# --- Redis, queues, cache, and rate limits ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true
# Optional dedicated Redis; otherwise REDIS_URL is used.
RATE_LIMIT_REDIS_URL=
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_SHORT_TTL_SECONDS=60
CACHE_LONG_TTL_SECONDS=1800

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SECURITY_ALERTS_ENABLED=true
SECURITY_ALERT_EMAIL=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Paystack subscriptions ---
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=
PAYSTACK_PLUS_MONTHLY_PLAN_CODE=
PAYSTACK_PROFESSIONAL_MONTHLY_PLAN_CODE=
PAYSTACK_ENTERPRISE_MONTHLY_PLAN_CODE=
PAYSTACK_PLUS_MONTHLY_AMOUNT_KOBO=1500000
PAYSTACK_PROFESSIONAL_MONTHLY_AMOUNT_KOBO=3500000
PAYSTACK_ENTERPRISE_MONTHLY_AMOUNT_KOBO=8000000

# --- AI providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# --- Media storage ---
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=weave-public-media
R2_PUBLIC_URL=
MEDIA_PUBLIC_BASE_URL=
