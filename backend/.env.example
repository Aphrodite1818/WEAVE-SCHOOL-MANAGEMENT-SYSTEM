#======================================#
#              .env.example            #
#======================================#


#--- App ---#
ENV=dev
# Leave LOG_LEVEL unset for normal defaults: dev=DEBUG, prod/stg=INFO
# Set LOG_LEVEL only when you intentionally need an override.
# LOG_LEVEL=INFO
APP_NAME="School Management System"
API_V1_PREFIX=/api/v1


#--- Security ---#
# generate with: openssl rand -hex 64
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


#--- Database ---#
# Set DATABASE_URL in the active environment file.
DATABASE_URL=


#--- CORS ---#
# JSON array format
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://localhost:8501","https://learnlyaischoolmanagement.vercel.app","https://learnlyaischoolmanagement-staging.vercel.app"]

# Frontend app URL used in emails and redirects. Set per environment file.
FRONTEND_APP_URL=

# Google Apps Script endpoint if your project depends on it.
APP_SCRIPT_URL=


#--- Paystack Subscriptions ---#
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=

PAYSTACK_STARTER_MONTHLY_PLAN_CODE=
PAYSTACK_STARTER_YEARLY_PLAN_CODE=
PAYSTACK_STANDARD_MONTHLY_PLAN_CODE=
PAYSTACK_STANDARD_YEARLY_PLAN_CODE=
PAYSTACK_PREMIUM_MONTHLY_PLAN_CODE=
PAYSTACK_PREMIUM_YEARLY_PLAN_CODE=

PAYSTACK_STARTER_MONTHLY_AMOUNT_KOBO=
PAYSTACK_STARTER_YEARLY_AMOUNT_KOBO=
PAYSTACK_STANDARD_MONTHLY_AMOUNT_KOBO=
PAYSTACK_STANDARD_YEARLY_AMOUNT_KOBO=
PAYSTACK_PREMIUM_MONTHLY_AMOUNT_KOBO=
PAYSTACK_PREMIUM_YEARLY_AMOUNT_KOBO=


#--- Gemini ---#
# get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_MAX_TOKENS=1024


#--- Twilio ---#
# get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# format: whatsapp:+14155238886  (sandbox) or your approved number
TWILIO_WHATSAPP_FROM=


#--- Cache ---#
# Redis URL for the active environment.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_SHORT_TTL_SECONDS=60
CACHE_LONG_TTL_SECONDS=108000
