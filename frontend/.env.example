# ====================================== #
#         Frontend environment           #
# ====================================== #

# --- Sentry error monitoring (optional) ---
# VITE_* variables are embedded into the browser bundle at build time.
# The browser DSN is intentionally public and safe to expose.
# Never put a Sentry auth token in a VITE_* variable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_DEBUG=false
